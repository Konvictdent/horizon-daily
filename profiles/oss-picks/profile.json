{
  "id": "oss-picks",
  "name": "Open-Source Picks",
  "display_names": {
    "zh": "开源项目推荐"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 4000,
    "enrichment_max_chars": 8000,
    "sampling": "head-middle-tail"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      {
        "id": "summary",
        "type": "section",
        "tools": [],
        "primary": true
      },
      {
        "id": "why_useful",
        "type": "section",
        "tools": []
      },
      {
        "id": "how_to_try",
        "type": "section",
        "tools": []
      },
      {
        "id": "caveat",
        "type": "section",
        "tools": [],
        "optional": true
      }
    ]
  }
}
