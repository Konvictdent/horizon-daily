{
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4.1-flash",
    "base_url": "https://opencode.ai/zen/go/v1",
    "api_key_env": "OPENCODE_GO_API_KEY",
    "headers": {
      "x-opencode-session": "horizon-daily-briefing"
    },
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 4
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 3.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "ai-models": {
        "threshold": 3.5,
        "topic_dedup": true
      },
      "world-news": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "politics-news": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "science-health": {
        "threshold": 3.5,
        "topic_dedup": true
      },
      "culture-news": {
        "threshold": 4.5,
        "topic_dedup": false
      },
      "oss-picks": {
        "threshold": 5.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
