    },
    "gdelt": {
      "enabled": true,
      "query": "(\"artificial intelligence\" OR \"large language model\" OR OpenAI OR Anthropic OR \"AI chip\" OR semiconductor)",
      "mode": "ArtList",
      "max_records": 30,
      "timespan": "24h",
      "language": "english",
      "category": "ai-news",
      "profile": "tech-news"
    },
    "google_news": {
      "enabled": true,
      "query": "artificial intelligence OR OpenAI OR Anthropic OR semiconductor",
      "language": "en",
      "country": "US",
      "max_results": 30,
      "category": "ai-news",
      "profile": "tech-news"
    }
