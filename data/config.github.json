  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "pushplus",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "token": "${PUSHPLUS_TOKEN}",
      "title": "#{message_title}",
      "content": "#{summary}",
      "template": "markdown"
    },
    "headers": ""
  },
  "wechat": {
    "enabled": false,
    "languages": [
      "zh"
    ],
    "chunk_size": 4000
